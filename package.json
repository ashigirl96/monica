  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.293",
      "@base-ui/react": "^1.4.1",
      "@crxjs/vite-plugin": "^3.0.0",
      "@fontsource-variable/inter": "^5.3.0",
      "@fontsource-variable/jetbrains-mono": "^5.3.0",
      "@orpc/client": "^1.15.4",
      "@orpc/contract": "^1.15.4",
      "@orpc/server": "^1.15.4",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-query": "^5.104.1",
      "@tauri-apps/api": "^2.12.1",
      "@tauri-apps/cli": "^2.12.1",
      "@tauri-apps/plugin-opener": "^2.5.5",
      "@types/chrome": "^0.3.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.1",
      "@xterm/addon-fit": "0.12.0-beta.301",
      "@xterm/addon-unicode11": "0.10.0-beta.301",
      "@xterm/addon-webgl": "0.20.0-beta.300",
      "@xterm/xterm": "6.1.0-beta.304",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "commander": "^14.0.3",
      "croner": "^10.0.1",
      "defuddle": "^0.19.4",
      "drizzle-kit": "^0.31.11",
      "drizzle-orm": "^0.45.3",
      "drizzle-zod": "^0.8.3",
      "entities": "^8.1.0",
      "framer-motion": "~12.42.2",
      "hono": "^4.13.12",
      "jotai": "^3.0.0",
      "linkedom": "^0.18.13",
      "lucide-react": "~0.564.0",
      "pdfjs-dist": "^6.4.299",
      "prosemirror-commands": "^1.7.2",
      "prosemirror-history": "^1.5.1",
      "prosemirror-inputrules": "^1.5.1",
      "prosemirror-keymap": "^1.2.3",
      "prosemirror-model": "^1.25.12",
      "prosemirror-state": "^1.4.4",
      "prosemirror-view": "^1.42.6",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "react-markdown": "^10.1.0",
      "remark-gfm": "^4.0.1",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.3",
      "trpc-cli": "^0.17.1",
      "tw-animate-css": "^1.4.0",
      "use-stick-to-bottom": "^1.1.6",
      "vite": "^8.3.2",
      "zod": "^4.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "monica": "scripts/monica-dev",
    "desktop": "bun scripts/desktop.ts",
    "web": "bun run --cwd apps/web dev",
    "extension": "bun scripts/extension.ts",
    "dev:list": "bun scripts/dev.ts list",
    "dev:kill": "bun scripts/dev.ts kill",
    "build": "bun scripts/build.ts",
    "install-app": "bun scripts/install-app.ts",
    "generate": "bun run --filter './packages/*' generate",
    "check": "bun run check:ts && bun run check:rust",
    "check:ts": "oxlint --no-error-on-unmatched-pattern --report-unused-disable-directives-severity=error && oxfmt --check && tsc --noEmit && bun scripts/test.ts &&bun run --cwd apps/desktop build && bun run --cwd apps/web build && bun run --cwd apps/extension build",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:brief": "bun scripts/check-brief.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
