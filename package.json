{
  "name": "tania",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@fontsource-variable/jetbrains-mono": "^5.3.0",
      "@orpc/client": "^1.15.4",
      "@orpc/contract": "^1.15.4",
      "@orpc/server": "^1.15.4",
      "@tailwindcss/vite": "^4.3.3",
      "@tauri-apps/api": "^2.12.1",
      "@tauri-apps/cli": "^2.12.1",
      "@tauri-apps/plugin-opener": "^2.5.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.1",
      "@xterm/addon-fit": "0.12.0-beta.301",
      "@xterm/addon-unicode11": "0.10.0-beta.301",
      "@xterm/addon-webgl": "0.20.0-beta.300",
      "@xterm/xterm": "6.1.0-beta.304",
      "clsx": "^2.1.1",
      "commander": "^14.0.3",
      "drizzle-kit": "^0.31.11",
      "drizzle-orm": "^0.45.3",
      "drizzle-zod": "^0.8.3",
      "hono": "^4.13.12",
      "jotai": "^3.0.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.3",
      "trpc-cli": "^0.17.1",
      "tw-animate-css": "^1.4.0",
      "vite": "^8.3.2",
      "zod": "^4.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "tania": "scripts/tania-dev",
    "desktop": "bun scripts/desktop.ts",
    "dev:list": "bun scripts/dev.ts list",
    "dev:kill": "bun scripts/dev.ts kill",
    "build": "bun scripts/build.ts",
    "install-app": "bun scripts/install-app.ts",
    "generate": "bun run --filter './packages/*' generate",
    "check": "bun run check:ts && bun run check:rust",
    "check:ts": "oxlint --no-error-on-unmatched-pattern --report-unused-disable-directives-severity=error && oxfmt --check && tsc --noEmit && bun test --pass-with-no-tests && bun run --cwd apps/desktop build",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
