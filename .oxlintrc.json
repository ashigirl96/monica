                  "@monica/cli/*",
                  "@monica/desktop",
                  "@monica/desktop/*",
                  "@monica/web",
                  "@monica/web/*"
                ],
                "message": "apps どうしは import しない（ADR-0002）"
              },
              {
                "group": ["@monica/*/server", "@monica/*/schema", "drizzle-orm", "drizzle-orm/**"],
                "allowTypeImports": true,
                "message": "DB に触るのは Backend だけで、ブラウザは procedure を呼ぶ（ADR-0003）"
              }
            ]
          }
        ]
      }
    },
    {
      // Chrome Extension の side panel と service worker でだけ動く。
      "files": ["apps/extension/**", "packages/chat/src/ui/**"],
      "rules": { "no-restricted-globals": "off" }
    },
    {
      "files": ["packages/*/src/**", "apps/backend/src/**"],
      "excludeFiles": ["**/*.test.ts", "**/testing.ts", "**/fake-*.ts"],
      "rules": { "monica/spawn-env": "error" }
    },
    {
      // apps/cli は自分の domain を持たず、テストが task の table に fixture を書くので入れない。
      "files": ["packages/*/src/**", "apps/backend/src/**"],
      "rules": { "monica/cross-domain-write": "error" }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "excludeFiles": ["**/*.test.ts", "**/testing.ts"],
      "rules": { "monica/testing-entry": "error" }
    },
    {
      // bun-types が `expect(…).rejects` の matcher を void を返す型にしているための誤検知。rule に従って await を外すと、test が reject を待たなくなる。
      "files": ["**/*.test.ts"],
      "rules": { "typescript/await-thenable": "off" }
    }
  ]
}
