{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react"],
  "categories": {
    "correctness": "error"
  },
  // 1 つの file に複数の override が当たると、後の override が no-restricted-imports の設定を丸ごと置き換える。
  // そのため file の集合ごとに、そこで守る制限をすべて並べる。
  // 「これ以外を禁じる」は group の否定（["*", "!drizzle-orm/sqlite-core"]）で書く。regex の先読みは黙って効かない。
  "overrides": [
    {
      "files": ["packages/workbench/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tania/task", "@tania/task/*"],
                "message": "workbench は task を import しない（ADR-0005）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/workbench/src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "bun:sqlite", "message": "ui は browser で動く（ADR-0009）" }],
            "patterns": [
              {
                "group": ["@tania/task", "@tania/task/*"],
                "message": "workbench は task を import しない（ADR-0005）"
              },
              {
                "group": ["@tania/*/server", "../server", "../server.ts"],
                "allowTypeImports": true,
                "message": "ui は browser で動くので server entry を import しない（ADR-0009）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/task/src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "bun:sqlite", "message": "ui は browser で動く（ADR-0009）" }],
            "patterns": [
              {
                "group": ["@tania/*/server", "../server", "../server.ts"],
                "allowTypeImports": true,
                "message": "ui は browser で動くので server entry を import しない（ADR-0009）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "bun:sqlite", "message": "ui は browser で動く（ADR-0009）" }],
            "patterns": [
              {
                "group": ["@tania/*"],
                "message": "packages/ui は domain を持たない部品なので、domain の package を import しない"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/workbench/src/schema.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!drizzle-orm/sqlite-core"],
                "message": "schema entry はどこでも import されるので drizzle-orm/sqlite-core だけを import する"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/task/src/schema.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!drizzle-orm/sqlite-core", "!@tania/workbench/schema"],
                "message": "schema entry は drizzle-orm/sqlite-core と、FK のための workbench の schema だけを import する"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tania/cli", "@tania/cli/*", "@tania/desktop", "@tania/desktop/*"],
                "message": "apps どうしは import しない（ADR-0002）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/cli/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@tania/backend",
                  "@tania/backend/*",
                  "@tania/desktop",
                  "@tania/desktop/*"
                ],
                "message": "apps どうしは import しない（ADR-0002）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@tania/backend", "@tania/backend/*", "@tania/cli", "@tania/cli/*"],
                "message": "apps どうしは import しない（ADR-0002）"
              }
            ]
          }
        ]
      }
    }
  ]
}
