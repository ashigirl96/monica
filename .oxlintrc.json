{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react"],
  "jsPlugins": ["./scripts/oxlint/monica.js"],
  "options": { "typeAware": true },
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "monica/sync-transaction": "error",
    "monica/disable-reason": "error",
    "monica/atom-deferred-get": "error",
    // jsx: react-jsx では JSX を書く file が React を import しなくてよい。
    "react/react-in-jsx-scope": "off",
    // 指定しないと oxlint は import type だけでできた循環を見逃す。
    "import/no-cycle": ["error", { "ignoreTypes": false }],
    // 名前の _ だけで判断するので、xterm の _core のような外が決めた名前にも当たる。
    "eslint/no-underscore-dangle": "off",
    // @monica/chat の html-worker と pdf-worker は、compiled binary の Worker の entrypoint（apps/backend/src/*-worker.ts）が読むだけで動く。
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css",
          "@fontsource-variable/*",
          "@monica/chat/html-worker",
          "@monica/chat/pdf-worker"
        ]
      }
    ],
    // unknown や Buffer を `${…}` に入れる形を咎める。`[object Object]` になる値は no-base-to-string が見る。
    "typescript/restrict-template-expressions": "off",
    // 害の無い不要な `!` と `as` を咎める。
    "typescript/no-unnecessary-type-assertion": "off",
    // `JSON.parse(…) as { pid: number }` のように、検査せずに型を付ける `as` をすべて咎める。
    "typescript/no-unsafe-type-assertion": "off",
    // React の effect の cleanup や網羅した switch のように、値を返さない分岐が意図どおりの関数に出る。返り値の抜けは tsc の noImplicitReturns が見る。
    "typescript/consistent-return": "off",
    // tsconfig が 1 つなので @types/chrome の chrome は全 file で型が付く。使ってよい file は override で外す。
    "no-restricted-globals": [
      "error",
      {
        "name": "chrome",
        "message": "chrome を使うのは apps/extension と chat の ui だけ（ADR-0029）"
      }
    ]
  },
  // 1 つの file に複数の override が当たると、後の override が no-restricted-imports の設定を丸ごと置き換える。
  // そのため file の集合ごとに、そこで守る制限をすべて並べる。
  // 「これ以外を禁じる」は group の否定（["*", "!drizzle-orm/sqlite-core"]）で書く。regex の先読みは黙って効かない。
  "overrides": [
    {
      "files": ["packages/workbench/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@monica/*/cli"],
                "message": "cli entry を import するのは apps/cli だけ（docs/packages.md の entry）"
              },
              {
                "group": ["@monica/task", "@monica/task/*"],
                "message": "workbench は task を import しない（ADR-0005）"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/workbench/src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "bun:sqlite", "message": "ui は browser で動く（ADR-0009）" }],
            "patterns": [
              {
                "group": ["@monica/*/cli"],
                "message": "cli entry を import するのは apps/cli だけ（docs/packages.md の entry）"
              },
              {
                "group": ["@monica/task", "@monica/task/*"],
                "message": "workbench は task を import しない（ADR-0005）"
              },
              {
                "group": ["@monica/*/server", "../server", "../server.ts"],
                "allowTypeImports": true,
                "message": "ui は browser で動くので server entry を import しない（ADR-0009）"
              },
              {
                "group": [
                  "@monica/*/schema",
                  "../schema",
                  "../schema.ts",
                  "drizzle-orm",
                  "drizzle-orm/**"
                ],
                "allowTypeImports": true,
                "message": "DB に触るのは Backend だけで、webview は procedure を呼ぶ（ADR-0003）"
              }
            ]
          }
        ]
