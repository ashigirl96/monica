{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["bun"]
  },
  "include": [
    "apps/*/src",
    "packages/*/src",
    "packages/*/migrations",
    "packages/*/drizzle.config.ts",
    "scripts"
  ]
}
