{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/*.md",
    "packages/workbench/src/hook-payloads/**",
    "packages/*/migrations/*/**"
  ],
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": { "stylesheet": "./apps/desktop/src/styles/globals.css", "functions": ["cn"] },
  "overrides": [{ "files": ["**/*.css"], "options": { "singleQuote": false } }]
}
